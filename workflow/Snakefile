import yaml
from snakemake.utils import min_version

min_version("9.19")

# !!!!! IMPORTANT !!!!!
# Define pathvars for all user resource files and result files
# This allows users to re-wire how the module is used in their workflow with ease.


pathvars:
    shapes="<resources>/user/{shapes}/shapes.parquet",
    scenario="config/scenarios/{scenario}.yaml",
    population="<resources>/user/{shapes}/population.csv",
    user_key="<resources>/user/{shapes}/user_key.csv",
    historical_production="<results>/{shapes}/historical/production.parquet",
    historical_production_aggregated="<results>/{shapes}/historical/production_aggregated.parquet",
    historical_energy_demand="<results>/{shapes}/historical/energy_demand.parquet",
    projected_production="<results>/{shapes}/{scenario}/projections/production.parquet",
    national_industrial_energy_demand="<results>/{shapes}/{scenario}/demand/industrial_energy_demand.parquet",
    national_route_production="<results>/{shapes}/{scenario}/demand/route_production.parquet",
    industrial_distribution_keys="<results>/{shapes}/spatial/industrial_distribution_keys.parquet",
    industrial_energy_demand="<results>/{shapes}/{scenario}/spatial/industrial_energy_demand.parquet",
    route_production="<results>/{shapes}/{scenario}/spatial/route_production.parquet",
    plots="<results>/{shapes}/{scenario}/plots/.plots_complete",
    maps="<results>/{shapes}/{scenario}/maps/.maps_complete",


# Load the example configuration. This will be overridden by users.
configfile: workflow.source_path("../config/config.yaml")


# FIXME: define a schema for the configuration file and other .yaml input files.
# Validate the configuration using the schema file.
# validate(config, workflow.source_path("internal/config.schema.yaml"))

# Load internal settings separately so users cannot modify them.
with open(workflow.source_path("internal/settings.yaml"), "r", encoding="utf-8") as f:
    internal = yaml.safe_load(f)


# Add all your includes here.
include: "rules/_utils.smk"
include: "rules/automatic.smk"
include: "rules/prepare.smk"
include: "rules/projections.smk"
include: "rules/transformations.smk"
include: "rules/visualizations.smk"
include: "rules/spatial.smk"


# Add additional files to be delivered alongside the workflow here.
# This is needed e.g. for python code files that are never
# explicitly used as a script or input in a snakemake rule.
# Imported Python helpers must also be available to remotely loaded scripts.
workflow.source_path("scripts/_industry_schema.py")
workflow.source_path("scripts/build_spatial_distribution_keys.py")


rule all:
    default_target: True
    output:
        "INVALID",
    log:
        stderr="<logs>/all.stderr",
    conda:
        "envs/module.yaml"
    message:
        "ERROR: Invalid `rule all:` call"
    shell:
        'echo "This workflow must be called as a snakemake module." > {log.stderr}'
